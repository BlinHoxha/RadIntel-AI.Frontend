# Synthetic fixtures only. Set false for an authenticated backend connection.
VITE_DEMO_MODE=true
# Opt in only for a loopback Development API; never enable in production.
VITE_ENABLE_DEVELOPMENT_AUTH=false
# Vite development proxy target; never include credentials.
RADINTEL_API_TARGET=http://localhost:5300

# Optional synthetic-only OHIF proof; requires npm run viewer:prepare and viewer:serve.
VITE_ENABLE_VIEWER_PROOF=false
VITE_VIEWER_ORIGIN=http://127.0.0.1:5184
