{
  "name": "radintel-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "contracts:generate": "node scripts/generate-contracts.mjs",
    "contracts:check": "node scripts/generate-contracts.mjs --check",
    "test:e2e:api": "playwright test --config playwright.api.config.ts",
    "test:integration": "node scripts/run-integration.mjs",
    "viewer:prepare": "node scripts/prepare-viewer.mjs",
    "viewer:serve": "node scripts/serve-viewer.mjs",
    "test:e2e:viewer": "playwright test --config playwright.viewer.config.ts",
    "test:e2e:viewer-demo": "playwright test --config playwright.viewer-demo.config.ts",
    "test:integration:viewer": "node scripts/run-integration.mjs --browser-only --viewer"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@tanstack/react-query": "^5.66.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "^1.51.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "22.13.10",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.10.3",
    "dicom-parser": "1.8.21",
    "eslint": "9.39.5",
    "globals": "16.0.0",
    "jsdom": "^26.0.0",
    "msw": "2.7.0",
    "openapi-typescript": "7.6.1",
    "prettier": "3.5.3",
    "typescript": "~5.7.3",
    "typescript-eslint": "8.72.2",
    "vite": "^6.1.0",
    "vitest": "^5.1.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "engines": {
    "node": ">=20.14.0"
  }
}
